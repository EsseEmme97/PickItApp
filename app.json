{
  "expo": {
    "name": "pickItApp",
    "slug": "pickItApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pick_it_app_logo.png",
    "scheme": "pickitapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/pick_it_app_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFAF1"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/pick_it_app_logo.png",
        "backgroundColor": "#FFFAF1"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.esseemme97.pickItApp",
      "enableProguardInReleaseBuilds": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/pick_it_app_logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "acde2fdd-f517-4321-8e40-e75be0a01562"
      }
    },
    "owner": "esseemme97"
  }
}
